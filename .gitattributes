# Makefile 與原始碼固定 LF（CRLF 會弄壞 make 與 diff）
Makefile text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.wav    binary
*.pdf    binary
*.bin    binary
# 講義測試資料要逐 byte 保留（含刻意放入的 CRLF），不做換行轉換
lectures/**/data/*.txt -text -eol
